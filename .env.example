# Copy to .env and fill in. Never commit .env.

# https://serpapi.com/manage-api-key — the free plan (250 searches/month) is enough.
SERPAPI_API_KEY=

# https://openrouter.ai/keys — Asli only uses free models.
OPENROUTER_API_KEY=

# live = real searches (cached); replay = recorded demo evidence, no keys or network needed.
ASLI_MODE=live

# Optional tuning
# ASLI_MAX_SEARCHES=8
# ASLI_DAILY_SEARCH_CAP=80
# ASLI_MIN_CREDITS_RESERVE=10
# ASLI_CACHE_TTL_HOURS=24
# ASLI_STORE_REPORTS=true
# ASLI_HOST=127.0.0.1
# ASLI_PORT=8000
# ASLI_LLM_REASONING=off
# ASLI_ALLOWED_HOSTS=
# ASLI_ACCESS_TOKEN=

# Copy to .env and fill in. Never commit .env.

# https://serpapi.com/manage-api-key — the free plan (250 searches/month) is enough.
SERPAPI_API_KEY=

# https://openrouter.ai/keys — Scamurai only uses free models.
OPENROUTER_API_KEY=

# live = real searches (cached); replay = recorded demo evidence, no keys or network needed.
SCAMURAI_MODE=live

# Optional tuning
# SCAMURAI_MAX_SEARCHES=8
# SCAMURAI_DAILY_SEARCH_CAP=80
# SCAMURAI_MIN_CREDITS_RESERVE=10
# SCAMURAI_CACHE_TTL_HOURS=24
# SCAMURAI_STORE_REPORTS=true
# SCAMURAI_HOST=127.0.0.1
# SCAMURAI_PORT=8000
# SCAMURAI_LLM_REASONING=off
# SCAMURAI_ALLOWED_HOSTS=
# SCAMURAI_ACCESS_TOKEN=
